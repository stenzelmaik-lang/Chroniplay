# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/.local-test/
/.dev.vars
# Checkout-local execution profile and tool state; never publish them.
/.sites-runtime/
/.agents/
/.codex/
/outputs/
/work/
*.tsbuildinfo

/.local-work/

# Screenshots und Ergebnisse lokaler Browsertests
/artifacts/

# Vision-Engine-Prototyp: Originalbilder und Töne nur lokal
/prototypes/vision-engine/local-assets/

# Szene-2.0-Entwurf: echter Referenzfall mit SL-Geheimnissen nur lokal (ins Repo kommt nur das neutrale Beispiel)
/prototypes/szene-2/*.local.js
